// Generated from cmake/config.hpp.in. Do not edit.
#ifndef KATAL_CONFIG_HPP_
#define KATAL_CONFIG_HPP_

#include <cstddef>

/// 1 when this Katal was built with the cuTENSOR backend. Without it only the
/// host-side layers work: Context, Plan, einsum and the device allocators are
/// still declared, but nothing defines them, so using one fails to link.
#cmakedefine01 KATAL_HAVE_CUTENSOR

/// What a failed KATAL_ASSERT does; see katal/assert.hpp. Generated, like
/// max_rank, so that inline code in a consumer agrees with the library.
#define KATAL_ASSERT_THROW 1
#define KATAL_ASSERT_ABORT 2
#define KATAL_ASSERT_IGNORE 3
#define KATAL_ASSERT_BEHAVIOR KATAL_ASSERT_@katal_assert_behavior@

namespace katal {

/// Largest tensor rank Katal can describe, and so the inline capacity of an
/// index. It bounds each operand and the result, not the distinct labels of a
/// whole equation: two operands at the maximum rank may share no labels at all.
/// Set it with -DKATAL_MAX_RANK at configure time. It is generated rather than
/// left as a plain macro so that a consumer cannot disagree with the library
/// about how big an index is.
inline constexpr std::size_t max_rank = @KATAL_MAX_RANK@;

}  // namespace katal

#endif  // KATAL_CONFIG_HPP_
