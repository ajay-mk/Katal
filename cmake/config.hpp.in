#ifndef KATAL_CONFIG_HPP_
#define KATAL_CONFIG_HPP_

#include <cstddef>

namespace katal {

/// Largest tensor rank Katal can describe, and so the inline capacity of an
/// index. It also bounds the number of distinct labels one equation may carry,
/// since classification forms the union of the operand indices. Set it with
/// -DKATAL_MAX_RANK at configure time. It is generated rather than left as a
/// plain macro so that a consumer cannot disagree with the library about how
/// big an index is.
inline constexpr std::size_t max_rank = @KATAL_MAX_RANK@;

}  // namespace katal

#endif  // KATAL_CONFIG_HPP_
